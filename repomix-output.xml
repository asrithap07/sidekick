      iconBg: "bg-amber-100 dark:bg-amber-900/40 text-amber-500",
      title: `${highPriority.length} high-priority task${highPriority.length > 1 ? "s" : ""} remaining`,
      body: `Start with "${highPriority[0].label}" to make the most impact today.`,
