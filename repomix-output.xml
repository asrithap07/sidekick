"use client";

import { useState } from "react";
import type { ProjectDraft } from "../../types/creation";

interface Props {
  initial: Pick<ProjectDraft, "goal" | "description" | "targetDate">;
  onNext: (data: Pick<ProjectDraft, "goal" | "description" | "targetDate">) => void;
}

