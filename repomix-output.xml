              {ins.icon}
            </div>
            <div>
              <p className="text-xs font-semibold text-gray-800 dark:text-gray-100 mb-0.5">{ins.title}</p>
              <p className="text-[11px] text-gray-400 dark:text-gray-500 leading-relaxed">{ins.body}</p>
