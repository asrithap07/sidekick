              <path d="M7 1.5l1.2 3.7L12 6.5l-3.8 1.3L7 12.5 5.8 7.8 2 6.5l3.8-1.3L7 1.5z" stroke="currentColor" strokeWidth="1.3" strokeLinejoin="round" />
            </svg>
