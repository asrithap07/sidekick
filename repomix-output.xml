"use client";
import React, { useState } from "react";
import { X } from "lucide-react";
import type { Project } from "@/types/project";

type EditProjectModalProps = {
  project: Project;
  onClose: () => void;
  onSave: (updates: Partial<Project>) => void;
  onDelete: () => void;
