  }

  if (insights.length === 0) {
    insights.push({
      icon: <Target size={14} />,
      iconBg: "bg-indigo-100 dark:bg-indigo-900/40 text-indigo-500",
      title: "Ready to plan your day?",
      body: "Ask me anything — I can help prioritise, break down tasks, or suggest a focus order.",
